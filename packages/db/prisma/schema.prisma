// Database schema.
//
// What this file cannot express lives in hand-written SQL migrations:
// row-level security policies, role grants, security-definer functions, check
// constraints and the partial unique index on incidents. See
// prisma/migrations/*_tenant_isolation.
//
// Conventions
// - Every table except `tenants` carries `tenant_id` and is protected by a
//   row-level security policy keyed on it.
// - Every parent that is referenced by a child exposes UNIQUE (tenant_id, id),
//   and children reference that pair. Foreign-key checks bypass row-level
//   security, so a plain FK on `id` would let a row point at another tenant's
//   parent; the composite key makes that impossible.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Vendor {
  datto_bcdr
  kaseya_uniview
  veeam_vspc
  mock

  @@map("vendor")
}

/// Normalized backup status. `missed` is derived by the missed-backup rule and
/// is only ever an asset's current status, never a stored vendor result.
enum BackupStatus {
  success
  warning
  failed
  missed
  running
  unknown

  @@map("backup_status")
}

enum SyncStatus {
  never
  running
  ok
  error

  @@map("sync_status")
}

/// Why a sync failed. Mirrors SYNC_ERROR_KINDS in packages/core.
enum SyncErrorKind {
  auth
  credentials
  rate_limited
  network
  vendor
  invalid_response
  unavailable
  internal

  @@map("sync_error_kind")
}

enum IncidentType {
  failed
  missed
  /// Longer than the asset's SLA without a completed backup.
  stale

  @@map("incident_type")
}

enum NotificationChannelType {
  webhook
  email

  @@map("notification_channel_type")
}

/// What one message to a channel is about.
enum NotificationBatchKind {
  /// Incidents that opened or closed in one sync.
  incidents
  /// An integration became unhealthy, or recovered.
  integration
  /// A test message someone asked for.
  test

  @@map("notification_batch_kind")
}

enum NotificationBatchStatus {
  pending
  sent
  /// Every attempt failed. Not tried again.
  failed

  @@map("notification_batch_status")
}

enum IncidentEvent {
  opened
  closed

  @@map("incident_event")
}

enum UserRole {
  owner
  technician

  @@map("user_role")
}

enum ActorType {
  user
  system

  @@map("actor_type")
}

/// One managed service provider. Maps 1:1 to a Clerk organization.
model Tenant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkOrgId String   @unique @map("clerk_org_id")
  name       String
  /// Hours added to an asset's expected frequency before it counts as missed.
  graceHours Int      @default(2) @map("grace_hours")
  /// IANA time zone the workspace reads dates and days in. Everything is stored in UTC.
  timeZone   String   @default("UTC") @map("time_zone")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                  User[]
  integrations           Integration[]
  clients                Client[]
  vendorClientMappings   VendorClientMapping[]
  assets                 Asset[]
  backupResults          BackupResult[]
  incidents              Incident[]
  auditLogs              AuditLog[]
  notificationChannels   NotificationChannel[]
  notificationBatches    NotificationBatch[]
  notificationDeliveries NotificationDelivery[]

  @@map("tenants")
}

/// A person's membership of one tenant. Someone in two tenants has two rows.
/// Rows are deactivated, not deleted, so audit entries stay attributable.
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  clerkUserId   String    @map("clerk_user_id")
  email         String
  name          String?
  role          UserRole  @default(technician)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  acknowledgedIncidents Incident[]
  mutedAssets           Asset[]
  auditLogs             AuditLog[]

  @@unique([tenantId, clerkUserId])
  @@unique([tenantId, id])
  @@map("users")
}

/// A connection to one vendor account.
model Integration {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  vendor              Vendor
  name                String
  /// Envelope-encrypted credentials. Never selected for the browser.
  credentialsEnc      Json           @map("credentials_enc")
  /// Last characters of the public key: the only credential-derived value shown in the UI.
  credentialHint      String?        @map("credential_hint")
  lastSyncAt          DateTime?      @map("last_sync_at") @db.Timestamptz(3)
  lastSyncStartedAt   DateTime?      @map("last_sync_started_at") @db.Timestamptz(3)
  syncStatus          SyncStatus     @default(never) @map("sync_status")
  /// Sanitized, human-readable reason for the last failed sync.
  lastSyncError       String?        @map("last_sync_error")
  /// What sort of failure that was. Decides whether retrying can help.
  lastSyncErrorKind   SyncErrorKind? @map("last_sync_error_kind")
  /// Failed syncs in a row. Zero after any successful sync.
  consecutiveFailures Int            @default(0) @map("consecutive_failures")
  /// When the current run of failures began. Null when the last sync succeeded.
  failingSince        DateTime?      @map("failing_since") @db.Timestamptz(3)
  /// When it was reported unhealthy. Cleared by the next successful sync, which reports the recovery.
  unhealthySince      DateTime?      @map("unhealthy_since") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorClientMappings VendorClientMapping[]
  assets               Asset[]
  backupResults        BackupResult[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("integrations")
}

/// One of the MSP's customers.
model Client {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorClientMappings VendorClientMapping[]
  assets               Asset[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("clients")
}

/// Links a vendor's own notion of a customer to a Client, so several vendors
/// can feed one client.
model VendorClientMapping {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  integrationId    String   @map("integration_id") @db.Uuid
  clientId         String   @map("client_id") @db.Uuid
  vendorClientId   String   @map("vendor_client_id")
  vendorClientName String   @map("vendor_client_name")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [tenantId, integrationId], references: [tenantId, id], onDelete: Cascade)
  client      Client      @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Cascade)

  @@unique([integrationId, vendorClientId])
  @@index([tenantId, clientId])
  @@map("vendor_client_mappings")
}

/// Something that is backed up: an agent, a share, a virtual machine.
model Asset {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String        @map("tenant_id") @db.Uuid
  clientId               String        @map("client_id") @db.Uuid
  integrationId          String        @map("integration_id") @db.Uuid
  vendorAssetId          String        @map("vendor_asset_id")
  name                   String
  /// Vendor's asset kind, lower-cased: agent, share, vm, ...
  type                   String
  /// The appliance or host the asset is protected by, when the vendor has one.
  deviceName             String?       @map("device_name")
  expectedFrequencyHours Int           @default(24) @map("expected_frequency_hours")
  slaHours               Int           @default(72) @map("sla_hours")
  mutedUntil             DateTime?     @map("muted_until") @db.Timestamptz(3)
  /// Why it was muted, in the words of whoever muted it. Kept while the mute stands.
  mutedReason            String?       @map("muted_reason")
  mutedByUserId          String?       @map("muted_by_user_id") @db.Uuid
  mutedAt                DateTime?     @map("muted_at") @db.Timestamptz(3)
  isPaused               Boolean       @default(false) @map("is_paused")
  isArchived             Boolean       @default(false) @map("is_archived")
  firstSeenAt            DateTime      @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt             DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  // Denormalized from backup_results by the sync job, so the dashboard does
  // not aggregate history on every load.
  lastResultAt           DateTime?     @map("last_result_at") @db.Timestamptz(3)
  /// Status of the most recent result. `currentStatus` is this, unless the
  /// missed-backup rule overrides it.
  lastResultStatus       BackupStatus? @map("last_result_status")
  /// When the last completed backup finished. A warning counts as completed.
  lastSuccessAt          DateTime?     @map("last_success_at") @db.Timestamptz(3)
  currentStatus          BackupStatus  @default(unknown) @map("current_status")
  /// When the asset went past its SLA without a completed backup. Null while inside it.
  staleSince             DateTime?     @map("stale_since") @db.Timestamptz(3)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Cascade)
  integration   Integration    @relation(fields: [tenantId, integrationId], references: [tenantId, id], onDelete: Cascade)
  mutedBy       User?          @relation(fields: [tenantId, mutedByUserId], references: [tenantId, id], onDelete: NoAction)
  backupResults BackupResult[]
  incidents     Incident[]

  @@unique([integrationId, vendorAssetId])
  @@unique([tenantId, id])
  @@index([tenantId, clientId])
  @@index([tenantId, currentStatus])
  @@map("assets")
}

/// One backup attempt as reported by a vendor, normalized.
model BackupResult {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  assetId            String       @map("asset_id") @db.Uuid
  integrationId      String       @map("integration_id") @db.Uuid
  /// Stable id for this attempt within the asset. Makes re-syncing idempotent.
  vendorResultId     String       @map("vendor_result_id")
  startedAt          DateTime     @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime?    @map("ended_at") @db.Timestamptz(3)
  status             BackupStatus
  /// The vendor's own status value, verbatim.
  vendorStatusRaw    String       @map("vendor_status_raw")
  message            String?
  /// Null when the vendor did not attempt screenshot verification.
  screenshotVerified Boolean?     @map("screenshot_verified")
  /// The vendor's payload for this attempt, as received. Never logged.
  rawPayload         Json         @map("raw_payload")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       Asset       @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Cascade)
  integration Integration @relation(fields: [tenantId, integrationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([assetId, vendorResultId])
  @@index([tenantId, assetId, startedAt(sort: Desc)])
  /// For the retention job, which works across tenants by age.
  @@index([startedAt])
  @@map("backup_results")
}

/// A problem with an asset that stays open until it resolves. At most one open
/// incident per asset per type (partial unique index, in SQL).
model Incident {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String       @map("tenant_id") @db.Uuid
  assetId              String       @map("asset_id") @db.Uuid
  type                 IncidentType
  openedAt             DateTime     @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt             DateTime?    @map("closed_at") @db.Timestamptz(3)
  acknowledgedByUserId String?      @map("acknowledged_by_user_id") @db.Uuid
  acknowledgedAt       DateTime?    @map("acknowledged_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset          Asset  @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Cascade)
  acknowledgedBy User?  @relation(fields: [tenantId, acknowledgedByUserId], references: [tenantId, id], onDelete: NoAction)

  notificationDeliveries NotificationDelivery[]

  @@unique([tenantId, id])
  @@index([tenantId, closedAt])
  @@index([tenantId, assetId])
  @@map("incidents")
}

/// Append-only record of who did what. The runtime role can insert and read
/// but cannot update or delete.
model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  actorType   ActorType @map("actor_type")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  /// Dotted verb, for example `integration.created`.
  action      String
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  /// Context for the action. Must never contain credentials or vendor payloads.
  metadata    Json      @default("{}")
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId, createdAt(sort: Desc)])
  /// For the retention job, which works across tenants by age.
  @@index([createdAt])
  @@map("audit_logs")
}

/// Somewhere notifications are sent: a webhook endpoint or a set of email
/// recipients, with what it wants to be told about.
model NotificationChannel {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String                  @map("tenant_id") @db.Uuid
  type                    NotificationChannelType
  name                    String
  enabled                 Boolean                 @default(true)
  /// Incident types it is told about.
  incidentTypes           IncidentType[]          @map("incident_types")
  notifyOpened            Boolean                 @default(true) @map("notify_opened")
  notifyClosed            Boolean                 @default(true) @map("notify_closed")
  notifyIntegrationHealth Boolean                 @default(true) @map("notify_integration_health")
  /// What may be shown in the interface: a hint of the destination, never the destination itself.
  config                  Json                    @default("{}")
  /// Envelope-encrypted destination and signing secret. Never selected for the browser. Null for email.
  secretEnc               Json?                   @map("secret_enc")
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches    NotificationBatch[]
  deliveries NotificationDelivery[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("notification_channels")
}

/// One message to one channel, waiting to be sent or already sent. Written in
/// the same transaction as the change it reports, so the two cannot disagree.
model NotificationBatch {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String                  @map("tenant_id") @db.Uuid
  channelId     String                  @map("channel_id") @db.Uuid
  kind          NotificationBatchKind
  /// What the message says, captured when it was written. Never credentials or vendor payloads.
  payload       Json
  status        NotificationBatchStatus @default(pending)
  /// Attempts made so far.
  attempts      Int                     @default(0)
  nextAttemptAt DateTime                @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  /// Sanitized reason the last attempt failed.
  lastError     String?                 @map("last_error")
  sentAt        DateTime?               @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel    NotificationChannel    @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([tenantId, id])
  @@index([tenantId, channelId, createdAt(sort: Desc)])
  @@map("notification_batches")
}

/// That a channel has been told about one event of one incident. The unique
/// key is the guarantee that it is never told twice, whatever a retry or a
/// crash does.
model NotificationDelivery {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  channelId  String        @map("channel_id") @db.Uuid
  incidentId String        @map("incident_id") @db.Uuid
  event      IncidentEvent
  batchId    String        @map("batch_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel  NotificationChannel @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade)
  incident Incident            @relation(fields: [tenantId, incidentId], references: [tenantId, id], onDelete: Cascade)
  batch    NotificationBatch   @relation(fields: [tenantId, batchId], references: [tenantId, id], onDelete: Cascade)

  @@unique([incidentId, event, channelId])
  @@index([tenantId, batchId])
  @@map("notification_deliveries")
}
