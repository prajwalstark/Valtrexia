# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Everything below is for LOCAL DEVELOPMENT. Production values come from your
# secret manager, not from a file.

# --- Local infrastructure (read by docker compose) -------------------------
POSTGRES_USER=valtrexia_owner
POSTGRES_PASSWORD=local-dev-owner-password
POSTGRES_DB=valtrexia
POSTGRES_PORT=5432
REDIS_PORT=6379

# Password for the runtime database role, valtrexia_app. The role is created by
# docker/postgres/init on first start; it cannot bypass row-level security and
# owns no tables. Its name is fixed because the migrations grant to it by name.
APP_DB_PASSWORD=local-dev-app-password

# --- Database connections ---------------------------------------------------
# Owner role: migrations only. Never used by the running app, which refuses
# to start if it finds itself connected as a privileged role.
DATABASE_URL_OWNER=postgresql://valtrexia_owner:local-dev-owner-password@localhost:5432/valtrexia
# App role: what apps/web and apps/worker connect as.
DATABASE_URL=postgresql://valtrexia_app:local-dev-app-password@localhost:5432/valtrexia

REDIS_URL=redis://localhost:6379

# --- Auth (Clerk) -----------------------------------------------------------
# From the Clerk dashboard. Organizations must be enabled and MFA required.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Credential encryption --------------------------------------------------
# "local" wraps data keys with VALTREXIA_LOCAL_KEK and refuses to start in
# production. Production uses a KMS provider.
VALTREXIA_KEY_PROVIDER=local
# 32 random bytes, base64. Generate with: openssl rand -base64 32
VALTREXIA_LOCAL_KEK=

# --- Sync -------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=15
DATTO_API_BASE_URL=https://api.datto.com/v1

# Enables the mock connector and demo data. Must be false in production.
VALTREXIA_ENABLE_MOCK=true
