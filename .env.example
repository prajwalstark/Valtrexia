# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Everything below is for LOCAL DEVELOPMENT. Production values come from your
# secret manager, not from a file.

# --- Local infrastructure (read by docker compose) -------------------------
POSTGRES_USER=valtrexia_owner
POSTGRES_PASSWORD=local-dev-owner-password
POSTGRES_DB=valtrexia
POSTGRES_PORT=5432
REDIS_PORT=6379

# Password for the runtime database role, valtrexia_app. The role is created by
# docker/postgres/init on first start; it cannot bypass row-level security and
# owns no tables. Its name is fixed because the migrations grant to it by name.
APP_DB_PASSWORD=local-dev-app-password

# --- Database connections ---------------------------------------------------
# Owner role: migrations only. Never used by the running app, which refuses
# to start if it finds itself connected as a privileged role.
DATABASE_URL_OWNER=postgresql://valtrexia_owner:local-dev-owner-password@localhost:5432/valtrexia
# App role: what apps/web and apps/worker connect as.
# In production both must use TLS: Postgres URLs need ?sslmode=verify-full,
# and REDIS_URL must be rediss:// with a password. The apps refuse otherwise.
DATABASE_URL=postgresql://valtrexia_app:local-dev-app-password@localhost:5432/valtrexia

# Used by the worker for its queues, and by the web app for rate limits
# shared across instances (required in production).
REDIS_URL=redis://localhost:6379

# --- Auth (Clerk) -----------------------------------------------------------
# From the Clerk dashboard (API keys). In the same dashboard, enable
# Organizations and require multi-factor authentication; see README.md.
# Read when the server runs, not when it is built, so one image serves every
# environment. The name Clerk's docs use, NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY,
# is also accepted.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From the webhook endpoint you create for /api/webhooks/clerk. Optional for
# local development: tenants and users are also created at sign-in.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Credential encryption --------------------------------------------------
# "local" wraps data keys with VALTREXIA_LOCAL_KEK and refuses to start in
# production. "aws-kms" wraps them with an AWS KMS key; use it in production.
VALTREXIA_KEY_PROVIDER=local
# 32 random bytes, base64. Generate with: openssl rand -base64 32
VALTREXIA_LOCAL_KEK=
# During a rotation only (not in production): earlier local keys,
# comma-separated, so records not yet moved can still be read.
VALTREXIA_PREVIOUS_LOCAL_KEKS=
# For aws-kms: the ARN of the KMS key, or of an alias for it. AWS credentials
# and region come from the usual AWS sources (an IAM role in production);
# the region defaults to the one in the ARN.
VALTREXIA_KMS_KEY_ID=

# --- Sync -------------------------------------------------------------------
# How often each integration is synced. Read by the worker, and by the web
# app to decide when data is too old to trust: give both the same value.
SYNC_INTERVAL_MINUTES=15
# Integrations the worker syncs at the same time.
SYNC_CONCURRENCY=5
# How often the scheduler looks for integrations that are due.
SCHEDULER_TICK_SECONDS=60
# How often the worker looks for notifications to send.
NOTIFICATION_TICK_SECONDS=30
# Retention, in days. Raw vendor payloads are emptied, then results and
# audit entries deleted, after these periods. Minimums: 7, 30 and 90.
RETENTION_RAW_PAYLOAD_DAYS=90
RETENTION_RESULT_DAYS=395
RETENTION_AUDIT_DAYS=730
# Lets notification channels send to http:// and to private addresses such as
# localhost, for testing a webhook receiver on your own machine. Ignored when
# NODE_ENV=production: tenants must never be able to reach internal addresses.
VALTREXIA_ALLOW_PRIVATE_DESTINATIONS=false
# How email notifications are sent. Empty: email channels cannot be added.
# "resend": sent through Resend. "log": development only, logs each email
# instead of sending it. Give the web app and the worker the same value.
EMAIL_PROVIDER=
# For EMAIL_PROVIDER=resend, read by the worker only. The key needs only
# "Sending access". The sender's domain must be verified in Resend.
RESEND_API_KEY=
# "Name <address>" or an address. Optional: where replies go instead.
EMAIL_FROM=
EMAIL_REPLY_TO=
# Datto's API root. Change only to point at a sandbox.
DATTO_API_BASE_URL=https://api.datto.com/v1
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# Enables the mock connector and demo data. Must be false in production.
VALTREXIA_ENABLE_MOCK=true
